{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "sh scripts/build.sh",
  "outputDirectory": "public",
  "build": {
    "env": {
      "HUGO_VERSION": "0.166.0"
    }
  },
  "redirects": [
    {
      "source": "/13-design-principles-for-data-pipelines",
      "destination": "/writing/13-design-principles-for-data-pipelines/",
      "permanent": true
    },
    {
      "source": "/core-data-pipeline-building-blocks-every-engineer-should-know",
      "destination": "/writing/core-data-pipeline-building-blocks-every-engineer-should-know/",
      "permanent": true
    },
    {
      "source": "/data-pipeline-components-architectural-blueprint",
      "destination": "/writing/data-pipeline-components-architectural-blueprint/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "smaddanki.vercel.app"
        }
      ],
      "destination": "https://smaddanki.com/:path*",
      "permanent": true
    }
  ],
  "installCommand": "npm install"
}
