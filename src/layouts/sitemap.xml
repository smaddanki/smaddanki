{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* @thulite/seo's sitemap ranges over .Pages, which on the home page is only
       the top-level sections — so the site map listed two URLs and no article.
       List every published page instead, minus the tag pages, which carry
       noindex and are disallowed in robots.txt. */ -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range site.Pages }}
  {{- if and .Permalink (ne .Params.sitemap_exclude true) (ne .Type "tags") (ne .Kind "taxonomy") }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
{{- end }}
</urlset>
